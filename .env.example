# The launcher reads an optional local .env file. Values can also be exported.
# Compose owns a separate local database; the host launcher supplies its SQL URL.
# Keep this password stable while retaining the project database volume.
ARENA_DATABASE_PASSWORD=arena_local
ARENA_DATABASE_PORT=55432
HTTP_ADDRESS=127.0.0.1:18081
# Zero means observed local blocks. Positive values require this many descendants.
CONFIRMATION_DEPTH=0

# Keeper uses a separate funded local account. Disable it to exercise manual progression.
KEEPER_ENABLED=true
# Empty uses the public local development key. A custom signer stays on the backend.
KEEPER_PRIVATE_KEY=''

# The launcher publishes chain ID, RPC URL, Arena address, and deployment block.
# Do not override the local deployment with stale values here.
# BACKEND_RPC_URL is supplied only inside the API container.

# Keep private keys and authenticated RPC credentials out of this template.
# Browser variables with a VITE_ prefix are public; never put secrets there.
